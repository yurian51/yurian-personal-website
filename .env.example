APP_NAME="Yurian Personal Website"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Dar_es_Salaam

DB_HOST=db
DB_PORT=5432
DB_NAME=yurian_personal
DB_USER=postgres
DB_PASSWORD=postgres

SESSION_NAME=yurian_session

# S3-compatible object storage for bookstore cover images
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=yurian-book-covers
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=https://pub-your-bucket.example.com
S3_PATH_STYLE=false
