RewriteEngine On
RewriteRule ^api/health$ api/health.php [L]
RewriteRule ^api/projects$ api/projects.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set X-Permitted-Cross-Domain-Policies "none"
Header always set Cross-Origin-Opener-Policy "same-origin"

<FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=86400"
</FilesMatch>

# The service worker must be revalidated so a deployment can replace it promptly.
<Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>
<Files "manifest.webmanifest">
    Header set Cache-Control "public, max-age=3600"
</Files>
